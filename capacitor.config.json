{
  "appId": "com.chubgames.app",
  "appName": "CHUBGAMES",
  "webDir": "dist",
  "plugins": {
    "BackgroundRunner": {
      "label": "com.chubgames.update",
      "src": "runners/update-check.js",
      "event": "checkUpdate",
      "repeat": true,
      "interval": 60,
      "autoStart": true
    }
  },
  "android": {
    "backgroundColor": "#0D0D10",
    "zoomingEnabled": false,
    "tintColor": "#FF7A18",
    "tintColorDark": "#FF7A18",
    "tintColorInvalid": "#FF6B4D",
    "allowMixedContent": false,
    "captureInput": false,
    "webContentsDebuggingEnabled": false
  }
}
